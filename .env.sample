# 환경 변수 샘플
# 이 파일은 키 이름과 형태 예시만 담는다. 아래 값은 모두 가짜다. 실제 값은 넣지 않는다 (AGENTS.md 4.3).
# 형식: 키=값 (따옴표 없이, = 앞뒤 공백 없이). 값에 공백이나 # 이 없으면 따옴표가 필요 없다.
# 프로젝트를 만들면 아래 두 파일로 나눠 복사해 값을 채운다. 두 파일은 git에 올리지 않는다.
#   - frontend/.env.local  : [프론트엔드] 부분
#   - backend/.env         : [백엔드] 부분
#
# Supabase 키는 새 방식(publishable / secret)을 쓴다. eyJ로 시작하는 긴 legacy 키(anon / service_role)는 쓰지 않는다.
# 값 위치: Supabase 대시보드 > Project Settings > API Keys

# ---------------------------------------------------------------
# [프론트엔드] frontend/.env.local
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저에 그대로 노출된다. 공개해도 되는 값만 둔다.
# ---------------------------------------------------------------

# Supabase 프로젝트 URL (예: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co

# Publishable key (sb_publishable_...). 브라우저용. RLS가 허용하는 데이터만 접근할 수 있다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# 백엔드(FastAPI) 주소 (개발 예: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------
# [백엔드] backend/.env
# 서버에서만 쓰는 값. 절대 프론트엔드 파일에 넣지 않는다.
# ---------------------------------------------------------------

# Supabase 프로젝트 URL (NEXT_PUBLIC_SUPABASE_URL과 같은 값)
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co

# Secret key (sb_secret_...). RLS를 우회하므로 서버에서만 쓴다. 유출되면 모든 데이터가 노출된다.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 프론트엔드 주소. 백엔드가 이 주소에서 오는 브라우저 요청만 허용한다(CORS). (개발 예: http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------
# AI 제공사 API 키 (backend/.env 에만. NEXT_PUBLIC_ 을 붙이지 않는다: AGENTS.md 4.3 "AI 호출은 서버에서만")
# 쓰지 않는 제공사는 비워 두거나 줄을 지운다. 이름은 각 공식 SDK가 기본으로 읽는 환경 변수 이름이다.
# ---------------------------------------------------------------

# Google Gemini. 발급: Google AI Studio. google-genai SDK가 기본으로 읽는 이름
# (GOOGLE_API_KEY 도 읽지만 둘 다 있으면 GOOGLE_API_KEY 가 우선이므로 GEMINI_API_KEY 하나만 쓴다)
GEMINI_API_KEY=REPLACE_ME

# OpenAI GPT. 발급: OpenAI Platform. openai SDK가 기본으로 읽는 이름
OPENAI_API_KEY=REPLACE_ME

# Anthropic Claude (지금은 사용 계획 없음, 자리만 둔다). 발급: Claude Console. anthropic SDK가 기본으로 읽는 이름
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# 카카오 로그인
# 카카오 키(REST API 키, Client Secret)는 이 파일에 넣지 않는다.
# Supabase 대시보드 > Authentication > Sign In / Providers > Kakao 에 직접 입력한다.
# 앱은 Supabase를 통해 카카오 로그인을 호출하므로 카카오 키를 알 필요가 없다.
# ---------------------------------------------------------------
